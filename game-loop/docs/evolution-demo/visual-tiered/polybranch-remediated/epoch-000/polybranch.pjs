  return g.speeds[g.speeds.length-1];
}

public int getGameScore(){
  return g.score;
}

public int getGameLevel(){
  return g.level;
}

//progress toward the next level, 0..100
public float progressForScore(int scoreIn, int levelIn){
  int idx = (levelIn < 1) ? 1 : levelIn;
  if(idx > g.scores.length - 1){
    return 100;
  }
  float from = g.scores[idx-1];
  float to = g.scores[idx];
  if(to <= from){
    return 100;
  }
  float pct = (scoreIn - from) * 100 / (to - from);
  if(pct < 0){
    pct = 0;
  }
  else if(pct > 100){
    pct = 100;
  }
  return pct;
}

