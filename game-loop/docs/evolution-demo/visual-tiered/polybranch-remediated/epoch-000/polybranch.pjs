    keys[0] = false;
    //player.velY = 0;
  }
  if (keyCode == DOWN || key == 's' || key == 'S') {
    keys[1] = false;
    //player.velY = 0;
  }
  if (keyCode == LEFT || key == 'a' || key == 'A') {
    keys[2] = false;
    //player.velX = 0;
  }
  if (keyCode == RIGHT || key == 'd' || key == 'D') {
    keys[3] = false;
    //player.velX = 0;
  }
}

public void pause(){
  if(paused){
    loop();
    paused = false;
    jsPauseMenu(false);
    jsStartGame(true);
  }else{
    noLoop();
    paused = true;
    jsPauseMenu(true);
  }
}

public void newGame(){
  player.reset();
  g.newGame();
  nearMisses = 0;
  streak = 0;
  bestStreak = 0;
  closeCallBonus = 0;
  lastNearMissFrame = 0;
  lastInputAt = millis();
  pointerSteerEnd();
  popups.clear();
  jsUpdateSpeed(g.speeds[0]);
}

//Runs a transient feedback message; keeps a bounded queue so long runs stay smooth.
void pushPopup(String labelIn, float yIn, int hueIn, int satIn, int brIn, int lifeIn){
  if(popups == null){
    popups = new ArrayList();
  }
  popups.add(new Popup(labelIn, yIn, hueIn, satIn, brIn, lifeIn));
  while(popups.size() > 4){
    popups.remove(0);
  }
}

// Deterministic runtime hook for the bounded smoke probe; gameplay never calls it.
public void forceScorePopup(){
  pushPopup("+100", height/2 + 40, 0, 100, 150, 90);
}

public void forceScoreForProbe(){
  g.score = 100;
  jsUpdateScore(g.score);
}

public int getNextScore(int indexIn){
  if(indexIn >= g.scores.length){
    return 0;
  }else{
    return g.scores[indexIn];
  }

}

