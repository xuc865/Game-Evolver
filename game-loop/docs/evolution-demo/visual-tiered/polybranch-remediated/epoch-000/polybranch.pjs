public String getPopupText(int indexIn){
  if(popups == null || indexIn < 0 || indexIn >= popups.size()){
    return "";
  }
  Object entryObj = popups.get(indexIn);
  if(entryObj != null && entryObj instanceof Popup){
    Popup popup = (Popup) entryObj;
    return popup.label;
  }
  return "";
}

