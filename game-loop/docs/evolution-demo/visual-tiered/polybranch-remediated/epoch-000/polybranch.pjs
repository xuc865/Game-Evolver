// --- run feedback state (near-miss close calls, streaks, in-canvas popups) ---
int nearMisses = 0;
int streak = 0;
int bestStreak = 0;
int closeCallBonus = 0;
int lastNearMissFrame = 0;
int lastInputAt = 0;
// pointer steering: the sketch owns aim + flight state, JS only reports raw pointer input
boolean pointerSteerActive = false;
float pointerTargetX = 0;
float pointerTargetY = 0;
int pointerSteerFrames = 0;
ArrayList popups;   // running feedback messages drawn inside the tunnel

// Returns an old popups ArrayList so callers never mutate the live queue.
ArrayList popupSnapshot() {
  ArrayList out = new ArrayList();
  for (int i = 0; i < popups.size(); i++) {
    out.add(popups.get(i));
  }
  return out;
}

PVector[] tris = {
      new PVector(200,200),
      new PVector(400,200),
      new PVector(0,100)
    };
    
PShape[] levelText = new PShape[11];

boolean[] keys = new boolean[4];
      
int originX;
int originY;

boolean paused;
                
//Tree testTree;

Player player;
Game g;

PVector focalPoint;

void setup(){
  paused = true;
  size(800,800);
  //frameRate(30);
  originX = width/2;
  originY = height/2;
  
  for(int i = 0; i < levelText.length; i++){
    levelText[i] = loadShape("svg/level"+(i+2)+".svg");
    levelText[i].disableStyle();
  }
  

  colorMode(HSB, 255);
  imageMode(CENTER);
  rectMode(CENTER);
  ellipseMode(CENTER);
  shapeMode(CENTER);
  focalPoint = new PVector(width/2,height/2);
  noStroke();
  background(230);
  //testTree = new Tree(5, bob);
  
  player = new Player();
  g = new Game();
  //Layer layer = new Layer(16, width, height);
  nearMisses = 0;
  streak = 0;
  bestStreak = 0;
  popups = new ArrayList();
  lastInputAt = millis();
  noLoop();

  processingIsReady();
  
}

void draw(){
  if(pointerSteerActive){
    pointerSteerFrames++;
  }else{
    pointerSteerFrames = 0;
  }
  if(keys[0] || keys[1] || keys[2] || keys[3]){
    lastInputAt = millis();
    player.hue += g.speed*100;
    if(player.hue > 255){
      player.hue = 0;
    }
  }
  if(keys[0] || keys[1]){
    if(keys[0]){
      //originY += player.speed;
      if(player.velY < 0 && dist(player.pos.x, player.pos.y, originX, originY + player.velY) > (height/2 - player.r - 8)){
        player.velY = 0;
      }
      player.velY += 0.3;
    }
    if(keys[1]){
      //originY -= player.speed;
      if(player.velY > 0 && dist(player.pos.x, player.pos.y, originX, originY + player.velY) > (height/2 - player.r - 8)){
        player.velY = 0;
      }
      player.velY -= 0.3;
    }
  }else if(pointerSteerActive){
    // pointer flight: the ship flies toward the pointer, the tunnel scrolls away
    lastInputAt = millis();
    player.hue += g.speed*100;
    if(player.hue > 255){
      player.hue = 0;
    }
    float steerDY = pointerTargetY - originY;
    float steerDistY = dist(0, originY, 0, pointerTargetY);
    if(steerDistY > 2){
      float steerMagY = min(0.45 * steerDistY, 14);
      // opposite of the pointer offset: the arrow keys push the tunnel away
      // from the ship's heading, so the pointer must do the same
      player.velY = -steerMagY * (steerDY / (steerDistY + 0.001));
    }else{
      player.velY = 0;
    }
  }else if(player.velY != 0.0){
    if(player.velY > 0){
      player.velY -= 0.5;
      if(player.velY < 0){
        player.velY = 0;
      }
    }else if(player.velY < 0){
      player.velY += 0.5;
      if(player.velY > 0){
        player.velY = 0;
      } 
    }
   
//    float brakes = (player.velY > 0) ? -0.5 : 0.5;
//    player.velY += brakes;
  }
  if(keys[2] || keys[3]){
    if(keys[2]){
      //originX += player.speed;
      if(player.velX < 0 && dist(player.pos.x, player.pos.y, originX + player.velX, originY) > (height/2 - player.r - 8)){
        player.velX = 0;
      }
      player.velX += 0.3;
    }
    if(keys[3]){
      //originX -= player.speed;
      if(player.velX > 0 && dist(player.pos.x, player.pos.y, originX + player.velX, originY) > (height/2 - player.r - 8)){
        player.velX = 0;
      }
      player.velX -= 0.3;
    }
  }else if(pointerSteerActive){
    // pointer flight continues horizontally: no brake decay while dragging
  }else if(player.velX != 0.0){
    if(player.velX > 0){
      player.velX -= 0.5;
      if(player.velX < 0){
        player.velX = 0;
      }
    }else if(player.velX < 0){
      player.velX += 0.5;
      if(player.velX > 0){
        player.velX = 0;
      } 
    }
    
    //    float brakes = (player.velX > 0) ? -0.5 : 0.5;
//    player.velX += brakes;
  }
  
  
  originX += player.velX;
  originY += player.velY;
  if(pointerSteerActive){
    // horizontal pointer flight: same convention as the vertical pass above
    float steerDX = pointerTargetX - originX;
    float steerDistX = dist(originX, 0, pointerTargetX, 0);
    if(steerDistX > 2){
      float steerMagX = min(0.45 * steerDistX, 14);
      // tunnel scrolls away from the pointer so the ship flies toward it
      player.velX = -steerMagX * (steerDX / (steerDistX + 0.001));
    }else{
      player.velX = 0;
    }
  }
  
  if(dist(player.pos.x, player.pos.y, originX, originY) > (height/2 - player.r - 8)){
    float a = myAngleBetween(player.pos, new PVector(originX, originY))-PI;
    originX = (int)(player.pos.x + (height/2 - player.r - 8) * cos(a));
    originY = (int)(player.pos.y + (height/2 - player.r - 8) * sin(a));
  }
  
  background(255);
  g.update();
  drawPopups();
  drawIdleHint();
}


//testtesttest
void mousePressed(){
 player.speed++;
}

// --- pointer steering API: JS reports raw pointer input, the sketch owns flight ---
public void pointerSteerBegin(float xIn, float yIn){
  pointerTargetX = xIn;
  pointerTargetY = yIn;
  if(!pointerSteerActive){
    pointerSteerActive = true;
  }
  lastInputAt = millis();
}

public void pointerSteerMove(float xIn, float yIn){
  if(!pointerSteerActive){
    return;
  }
  pointerTargetX = xIn;
  pointerTargetY = yIn;
  lastInputAt = millis();
}

public void pointerSteerEnd(){
  pointerSteerActive = false;
  pointerSteerFrames = 0;
}

public boolean isPointerSteering(){
  return pointerSteerActive;
}

public float getPointerSteerX(){
  return pointerTargetX;
}

public float getPointerSteerY(){
  return pointerTargetY;
}

//how long the pointer has been flying, for the HUD feedback
public int getPointerSteerFrames(){
  return pointerSteerFrames;
}

//In-canvas feedback so the tunnel itself acknowledges what just happened.
void drawPopups(){
  if(popups == null){
    return;
  }
  if(popups.size() == 0){
    return;
  }
  textAlign(CENTER, CENTER);
  textSize(24);
  for(int i = popups.size() - 1; i >= 0; i--){
    Object entryObj = popups.get(i);
    if(entryObj == null || !(entryObj instanceof Popup)){
      //never let a stale entry abort the frame
      popups.remove(i);
      continue;
    }
    Popup popup = (Popup) entryObj;
    if(popup.age < 0 || popup.age > popup.life){
      popups.remove(i);
      continue;
    }
    int alpha = (int)map(popup.age, popup.life * 0.45, popup.life, 255, 0);
    if(alpha < 0){
      alpha = 0;
    }
    else if(alpha > 255){
      alpha = 255;
    }
    noStroke();
    fill(popup.hue, popup.sat, popup.br, alpha);
    rect(width/2, popup.y, width*0.34, 40, 10);
    fill(0, 0, 0, alpha);
    text(popup.label, width/2, popup.y);
    popup.age++;
    if(popup.age > popup.life){
      popups.remove(i);
    }
  }
  textAlign(LEFT, BASELINE);
  noStroke();
}

//Gentle "steer to dodge" nudge that only appears before the first input.
void drawIdleHint(){
  if(g == null || g.isGameOver || paused){
    return;
  }
  if(millis() - lastInputAt < 3500 || nearMisses + streak > 0){
    return;
  }
  fill(0, 0, 0, 150);
  textAlign(CENTER, CENTER);
  textSize(18);
  text(pointerSteerActive ? "drag to dodge the branches" : "steer with the arrow keys", width/2, height/2 + 70);
  textAlign(LEFT, BASELINE);
}

//One transient feedback message drawn inside the tunnel.
class Popup{
  String label;
  float y;
  int hue, sat, br;
  int age = 0;
  int life = 110;

  Popup(String labelIn, float yIn, int hueIn, int satIn, int brIn){
    label = labelIn;
    y = yIn;
    hue = hueIn;
    sat = satIn;
    br = brIn;
  }
}

