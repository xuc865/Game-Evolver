{
  "benchmark": {
    "adapter": "vgamegym",
    "options": {
      "root": "/Users/wangxucong/Desktop/workspace/harness-game/game-loop"
    }
  },
  "backend": {
    "command": [
      "/Users/wangxucong/Desktop/workspace/harness-game/.venv/bin/python",
      "-m",
      "game_loop.benchmarks.vgamegym_bridge",
      "--agent-workspace",
      "{agent_workspace}",
      "--instruction-file",
      "{instruction_file}",
      "--task-root",
      "{task_root}",
      "--output-manifest",
      "{output_manifest}",
      "--evaluator-command-json",
      "[\"/Users/wangxucong/Desktop/workspace/harness-game/.venv/bin/python\", \"/Users/wangxucong/Desktop/workspace/harness-game/game-loop/scripts/run_vgamegym_official_evaluator.py\", \"--official-root\", \"/Users/wangxucong/Desktop/workspace/harness-game/third_party/VGameGym\", \"--task-root\", \"{{task_root}}\", \"--artifact-dir\", \"{{artifact_dir}}\", \"--raw-output\", \"{{raw_output}}\"]"
    ],
    "cwd": ".",
    "timeout_seconds": 600,
    "env": {
      "CODEX_API_BASE": "http://29.116.237.135:8080/v1",
      "CODEX_MODEL": "Kimi-K2.7-Code",
      "GAME_LOOP_BACKBONE_PROVIDER": "kimi",
      "VGAMEGYM_VL_BASE_URL": "http://29.116.237.141:8080/v1",
      "VGAMEGYM_TEXT_BASE_URL": "http://29.116.237.135:8080/v1",
      "VGAMEGYM_TEXT_MODEL": "Kimi-K2.7-Code"
    }
  },
  "method": {
    "level": "L4",
    "fixed_probes": [
      {
        "id": "pygame_runtime",
        "command": [
          "python3",
          "-m",
          "game_loop.probe_tools",
          "pygame-runtime",
          "--artifact",
          "{artifact_dir}",
          "--run-seconds",
          "8"
        ],
        "cwd": ".",
        "parser": "json_stdout",
        "selection_mode": "required",
        "timeout_seconds": 60,
        "tags": [
          "ImproveObjective",
          "runtime"
        ]
      }
    ],
    "probe_families": [
      {
        "id": "pygame_runtime_horizon",
        "gene": {
          "name": "run_seconds",
          "initial": 8,
          "minimum": 4,
          "maximum": 60,
          "step": 4,
          "difficulty_direction": "increasing"
        },
        "probe": {
          "cwd": ".",
          "command": [
            "python3",
            "-m",
            "game_loop.probe_tools",
            "pygame-runtime",
            "--artifact",
            "{artifact_dir}",
            "--run-seconds",
            "[[run_seconds]]"
          ],
          "timeout_seconds": 120,
          "selection_mode": "regression_anchor",
          "parser": "json_stdout",
          "tags": [
            "ImproveObjective",
            "runtime"
          ]
        },
        "archive_capacity": 8
      }
    ],
    "max_probe_calls": 12,
    "active_selection": {
      "max_selected_probes": 2,
      "min_observations_per_probe": 1
    },
    "harness_evolution": {
      "modules": [
        {
          "id": "context_compiler",
          "instruction": "Compile context from task requirements, parent artifact state, and feedback signals.",
          "tags": [
            "context"
          ]
        },
        {
          "id": "module_strategy",
          "instruction": "Select and order modules based on task type and recent outcomes.",
          "tags": [
            "strategy"
          ]
        },
        {
          "id": "skill_governance",
          "instruction": "Curate skill descriptions and manage skill loading priorities.",
          "tags": [
            "skills"
          ]
        },
        {
          "id": "tool_interface",
          "instruction": "Manage tool interface assembly and safety scoping.",
          "tags": [
            "tools"
          ]
        },
        {
          "id": "probe_governance",
          "instruction": "Select and parameterise probes based on coverage and regression signals.",
          "tags": [
            "probes"
          ]
        },
        {
          "id": "feedback_synthesis",
          "instruction": "Synthesize structured feedback from evaluator outputs and probe observations.",
          "tags": [
            "feedback"
          ]
        },
        {
          "id": "artifact_persistence",
          "instruction": "Manage artifact snapshots, delivery contracts, and rollback points.",
          "tags": [
            "persistence"
          ]
        },
        {
          "id": "session_routing",
          "instruction": "Route sessions across heterogeneous agent frameworks and model backends.",
          "tags": [
            "routing"
          ]
        }
      ],
      "tool_interfaces": [],
      "seed_modules": [
        "context_compiler"
      ],
      "max_active_modules": 2,
      "max_active_tool_interfaces": 1,
      "mutation_width": 1,
      "replay_min_cases": 2,
      "rubric_validation_sample_size": 2,
      "loop_role": "outer",
      "require_rubric_validation": true,
      "dynamic_rubric_generation": true,
      "enable_usage_driven_mutation": false,
      "rubric_provider": "deepseek",
      "element_mutation_policy": {
        "removal_min_usage": 5,
        "removal_min_usage_share": 0.25,
        "removal_max_accuracy": 0.35,
        "merge_min_similarity": 0.55
      },
      "allowed_niches": [
        "context_compiler"
      ]
    }
  },
  "evolution": {
    "max_generations": 3,
    "candidates_per_generation": 1,
    "max_model_calls": 3,
    "max_evaluator_queries": 3
  },
  "reliability": {
    "pause_on_infrastructure_failure": true
  },
  "gates": {
    "max_files": 5000,
    "max_total_bytes": 1073741824
  },
  "experiment": {
    "arm": "L4_agent",
    "ablation_level": "L1"
  }
}
