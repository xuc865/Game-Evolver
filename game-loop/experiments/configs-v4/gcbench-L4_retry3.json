{
  "benchmark": {
    "adapter": "gcbench",
    "options": {
      "root": "/Users/wangxucong/Desktop/workspace/harness-game/gcbench"
    }
  },
  "backend": {
    "command": [
      "bash",
      "scripts/run_gcbench_l4_backend.sh",
      "{candidate_workspace}",
      "{instruction_file}",
      "{artifact_path}",
      "{output_manifest}",
      "{task_id}",
      "{gcbench_root}",
      "{breakdown_path}"
    ],
    "cwd": ".",
    "timeout_seconds": 1800,
    "env": {
      "CODEX_API_BASE": "http://29.116.237.135:8080/v1",
      "CODEX_MODEL": "Kimi-K2.7-Code"
