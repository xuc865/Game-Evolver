        {
          "id": "late_subscriber_recovery",
          "category": "repair",
          "instruction": "Preserve the existing compiling BossEncounterHUD. Fix only the real late-subscriber bug: while a boss encounter is active, resend boss.state every 1-2 seconds using a bounded server-side monotonic clock guard. Keep spawn, health, cast, phase, death, and abort pushes immediate. Never send reliable state every physics frame.",
          "tags": ["networking", "hud", "recovery"]
        },
        {
          "id": "runtime_evidence_first",
          "category": "observability",
          "instruction": "Run Godot import/compile validation after the focused production change and before finishing. Treat runtime evidence as authoritative.",
          "tags": ["godot", "evidence", "testing"]
        },
        {
          "id": "minimal_patch",
          "category": "workflow",
          "instruction": "This is a narrow reliability correction. Prefer one timestamp, one 1-2 second constant, and one guarded push in BossController. Do not rebuild the HUD, create a generic synchronization framework, or alter combat tuning.",
          "tags": ["scope", "delivery"]
        },
        {
          "id": "revision_consistency",
          "category": "protocol",
          "instruction": "Every heartbeat is a normal authoritative boss.state update with a newer revision and clock-safe cast_remaining_ms. Preserve stale packet rejection and lifecycle cleanup.",
          "tags": ["ordering", "authority", "lifecycle"]
        },
        {
          "id": "real_scene_only",
          "category": "strategy",
          "instruction": "Integrate through the existing final dungeon RoomNode and production HUD. Do not create a standalone showcase, alternate main scene, fake boss, or playtest-only main path.",
          "tags": ["production", "playtest"]
        },
        {
          "id": "bounded_recovery_evidence",
          "category": "observability",
          "instruction": "Inspect the production BossController after editing: recovery must be driven by elapsed monotonic time, limited to active encounters, and retain immediate event pushes. Then compile the whole Godot project.",
          "tags": ["boundedness", "evidence"]
        },
        {
          "id": "rejection_escape",
          "category": "strategy",
          "instruction": "If rejected, inspect the exact failed contract or integration invariant and change the implementation rather than layering on cosmetic effects.",
          "tags": ["exploration", "feedback"]
        }
      ],
