      "max_active_modules": 5,
      "max_active_tool_interfaces": 1,
      "mutation_width": 1,
      "replay_min_cases": 1,
      "promotion_delta_min": 0.02,
      "max_case_regression": 0.02,
      "require_rubric_validation": false,
      "dynamic_rubric_generation": false,
      "hard_rubrics": [
        {
          "rubric_id": "architecture_intact",
          "kind": "hard",
          "description": "Client, gateway, master, world server, byte-packed protocol, FinalRoom, BossController, and production HUD remain intact."
        },
        {
          "rubric_id": "godot_compiles",
          "kind": "hard",
          "description": "Godot 4.6.3 validation completes without GDScript parse or compile errors."
        },
        {
          "rubric_id": "authoritative_real_scene",
          "kind": "hard",
          "description": "All presentation is driven by real boss.state transitions in the production FinalRoom; no fake payload or alternate demo scene."
        }
      ],
      "soft_rubrics": [
        {
          "rubric_id": "screenshot_impact",
          "kind": "soft",
          "description": "The persistent Boss frame is visually dominant and immediately communicates Boss identity, HP, and phase.",
          "weight": 0.30
        },
        {
          "rubric_id": "combat_readability",
          "kind": "soft",
          "description": "Real casts and Phase 2 transitions create unmistakable, timely danger and escalation feedback.",
          "weight": 0.30
