    "harness_evolution": {
      "loop_role": "inner",
      "modules": [
        {
          "id": "real_state_driven_spectacle",
          "category": "strategy",
          "instruction": "Improve the production BossEncounterHUD using only real boss.state payload transitions. Never create a preview payload, alternate scene, fake Boss, or timer-driven state that is not anchored to an authoritative encounter update.",
          "tags": ["production", "demo", "authority"]
        },
        {
          "id": "encounter_visual_hierarchy",
          "category": "gameplay",
          "instruction": "Make the persistent Boss frame screenshot-obvious at 960x540: roughly 560-680 px wide with a health bar at least 520x24, strong name hierarchy, numeric HP, and professional contrast. Preserve gameplay visibility.",
          "tags": ["hud", "readability", "visual"]
        },
        {
          "id": "transition_state_machine",
          "category": "protocol",
          "instruction": "Use explicit encounter-id, phase, cast, and active/aborted transitions so reveal, enrage, danger, victory, and cleanup each fire exactly once per authoritative transition. Heartbeats and duplicate revisions must not replay presentation effects.",
          "tags": ["ordering", "lifecycle", "animation"]
        },
        {
          "id": "cast_urgency",
          "category": "gameplay",
          "instruction": "During a real cast, display a central high-contrast warning banner with large SLAM - MOVE OUT action copy, countdown/progress, and restrained pulsing. Clear it immediately on the newer authoritative cast-end state.",
          "tags": ["combat", "telegraph", "hud"]
        },
        {
          "id": "phase_and_victory_payoff",
          "category": "gameplay",
          "instruction": "On a true phase 1 to phase 2 update, show a conspicuous transition and keep a persistent ENRAGED badge plus hotter frame/HP styling for the remainder of authoritative phase 2. On normal death show victory before hiding; abort/disconnect/instance change must reset immediately.",
          "tags": ["phase", "victory", "feedback"]
        },
        {
          "id": "focused_hud_patch",
          "category": "workflow",
          "instruction": "Prefer a focused edit to source/client/ui/hud/boss_encounter_hud.gd. Reuse its existing Controls and Tweens, do not build a generic UI framework, do not change combat tuning, and do not rewrite BossController networking.",
          "tags": ["scope", "maintainability"]
        },
        {
          "id": "runtime_evidence_first",
          "category": "observability",
          "instruction": "Run full Godot validation and exercise BossEncounterHUD construction after the production HUD change. Reject nonexistent theme APIs. Preserve revision rejection, cross-process cast timing, heartbeat recovery, and all real Boss combat paths.",
          "tags": ["godot", "testing", "regression"]
        },
        {
          "id": "rejection_escape",
          "category": "strategy",
          "instruction": "If rejected, address the exact missing visible transition or lifecycle contract with a different implementation rather than adding unrelated polish.",
          "tags": ["feedback", "exploration"]
        }
      ],
      "tool_interfaces": [
        {
          "id": "godot_headless",
          "kind": "engine_probe",
          "description": "Run bounded Godot 4.6.3 validation inside the candidate workspace.",
          "command": [
            "/Applications/Godot.app/Contents/MacOS/Godot",
            "--headless",
            "--editor",
            "--path",
            "{candidate_workspace}",
            "--quit"
          ],
          "cwd": "/Users/wangxucong/Desktop/workspace/harness-game/game-loop",
          "safety_scope": "candidate_workspace_only",
          "tags": ["godot", "runtime"]
        }
      ],
      "seed_modules": [
        "real_state_driven_spectacle",
        "encounter_visual_hierarchy",
        "transition_state_machine",
        "cast_urgency",
        "phase_and_victory_payoff"
      ],
