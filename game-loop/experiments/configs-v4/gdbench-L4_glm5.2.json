{
  "benchmark": {
    "adapter": "gdbench",
    "options": {
      "root": "/Users/wangxucong/Desktop/workspace/harness-game/third_party/gamedevbench"
    }
  },
  "backend": {
    "command": [
      "bash",
      "scripts/run_chat_agent_direct.sh"
    ],
    "cwd": ".",
    "timeout_seconds": 300,
    "env": {
      "CODEX_API_KEY": "sk-placeholder",
      "CODEX_API_BASE": "http://29.116.237.5:8080/v1",
      "CODEX_MODEL": "GLM-5.2-W4AFP8-node6"
    }
  },
  "method": {
    "level": "L4",
    "fixed_probes": [
      {
        "id": "godot_public_import",
        "command": [
          "python3",
          "-m",
          "game_loop.probe_tools",
          "godot-import",
          "--artifact",
          "{artifact_dir}"
        ],
        "cwd": ".",
        "parser": "json_stdout",
        "selection_mode": "required",
        "timeout_seconds": 180,
        "tags": [
          "RepairConstraint",
          "godot"
        ]
      },
      {
        "id": "godot_public_runtime",
        "command": [
          "python3",
          "-m",
          "game_loop.probe_tools",
          "godot-playtest",
          "--artifact",
          "{artifact_dir}",
          "--frames",
          "600"
        ],
        "cwd": ".",
        "parser": "json_stdout",
        "selection_mode": "required",
        "timeout_seconds": 600,
        "tags": [
          "ImproveObjective",
          "runtime"
        ]
      },
      {
        "id": "gdbench_official_validation",
        "command": [
          "python3",
          "-m",
          "game_loop.probe_tools",
          "gdbench-validation",
          "--artifact",
          "{artifact_dir}",
          "--task-source",
          "{task_source}"
        ],
        "cwd": ".",
        "parser": "json_stdout",
        "selection_mode": "required",
        "timeout_seconds": 600,
        "tags": [
          "RepairConstraint",
          "validation"
        ]
      }
    ],
    "probe_families": [
      {
        "id": "godot_runtime_horizon",
        "gene": {
          "name": "frames",
          "initial": 600,
          "minimum": 100,
          "maximum": 1800,
          "step": 100,
          "difficulty_direction": "increasing"
        },
        "probe": {
          "cwd": ".",
          "command": [
            "python3",
            "-m",
            "game_loop.probe_tools",
            "godot-playtest",
            "--artifact",
            "{artifact_dir}",
            "--frames",
            "[[frames]]"
          ],
          "timeout_seconds": 1800,
          "selection_mode": "regression_anchor",
          "parser": "json_stdout",
          "tags": [
            "ImproveObjective",
            "runtime"
          ]
        },
        "archive_capacity": 8
      }
    ],
    "max_probe_calls": 24,
    "active_selection": {
      "max_selected_probes": 4,
      "min_observations_per_probe": 1
    },
    "harness_evolution": {
      "modules": [
        {
          "id": "evidence_first",
          "instruction": "Inspect executable evidence before choosing a patch.",
          "tags": [
            "ImproveObjective",
            "functional_visuals"
          ]
        },
        {
          "id": "gameplay_observability",
          "instruction": "Collect runtime and visual observations before accepting a candidate.",
          "tags": [
            "ImproveObjective",
            "gameplay"
          ]
        },
        {
          "id": "mechanic_depth",
          "instruction": "Prefer changes that deepen mechanics rather than cosmetic-only edits.",
          "tags": [
            "ImproveObjective",
            "mechanics"
          ]
        },
        {
          "id": "regression_first",
          "instruction": "Re-run preserved behavior before finishing.",
          "tags": [
            "RepairConstraint",
            "feasibility"
          ]
        },
        {
          "id": "engine_tooling_first",
          "instruction": "Use engine tooling to inspect import/runtime state before patching.",
          "tags": [
            "engine_tooling",
            "godot"
          ]
        },
        {
          "id": "diversity_escape",
          "instruction": "Avoid repeating a recently rejected change family.",
          "tags": [
            "ExploreAlternative",
            "exploration"
          ]
        },
        {
          "id": "minimal_coherent_patch",
          "instruction": "Keep patches minimal and coherent with the existing project structure.",
          "tags": [
            "RepairConstraint",
            "feasibility"
          ]
        }
      ],
      "tool_interfaces": [
        {
          "id": "godot_cli_runtime",
          "kind": "engine_probe",
          "description": "Run Godot import/runtime checks against the candidate workspace.",
          "command": [
            "python3",
            "-m",
            "game_loop.probe_tools",
            "godot-playtest",
            "--artifact",
            "{artifact_dir}"
          ],
          "safety_scope": "candidate_workspace_only",
          "tags": [
            "engine_tooling",
            "godot"
          ]
        },
        {
          "id": "godot_mcp_screenshot",
          "kind": "mcp_server",
          "description": "Capture engine/runtime screenshots through a bounded MCP wrapper.",
          "command": [
            "python3",
            "-m",
            "game_loop.probe_tools",
            "godot-playtest",
            "--artifact",
            "{artifact_dir}",
            "--frames",
            "120"
          ],
          "safety_scope": "candidate_workspace_only",
          "tags": [
            "engine_tooling",
            "visual"
          ]
        }
      ],
      "seed_modules": [
        "evidence_first",
        "regression_first",
        "engine_tooling_first"
      ],
      "max_active_modules": 3,
      "max_active_tool_interfaces": 2,
      "mutation_width": 1,
      "replay_min_cases": 2,
      "promotion_delta_min": 0.03,
      "max_case_regression": 0.08
    }
  },
  "evolution": {
    "max_generations": 3,
    "candidates_per_generation": 1,
    "max_model_calls": 3,
    "max_evaluator_queries": 3
  },
  "reliability": {
    "pause_on_infrastructure_failure": true
  },
  "gates": {
    "max_files": 5000,
    "max_total_bytes": 1073741824
  },
  "experiment": {
    "arm": "L4_agent"
  }
}
