{
  "runtime_type": "deepseek-harness",
  "runtime_id": "deepseek-harness-sdk-v1",
  "provider": "deepseek-official",
  "model": "deepseek-v4-flash",
  "backbone_provider": "deepseek",
  "max_tokens": 49152,
  "cordis": "/absolute/path/to/game-loop/experiments/inner-agent/deepseek-harness.cordis.yml",
  "runtime_cwd": "/absolute/path/to/deepseek-harness",
  "timeout_seconds": 7200,
  "shutdown_timeout_seconds": 5.0,
  "successful_finish_reasons": ["completed"],
  "cordis_plugin_catalog": {
    "repeat_tool_reminder": [
      {"id": "evolved-repeat-tool-reminder", "name": "@deepseek-ai/dsh-repeat-tool-reminder", "config": {"thresholds": [3, 5, 8], "exclude": ["todo_write"]}}
    ],
    "llm_retry": [
      {"id": "evolved-llm-retry", "name": "@deepseek-ai/dsh-llm-retry"}
    ],
    "workflow_orchestration": [
      {"id": "evolved-workflow-worker", "name": "@deepseek-ai/dsh-workflow-worker-thread", "config": {"provider": "spawn", "maxConcurrentAgents": 2, "maxTotalAgents": 4, "maxItemsPerCall": 12, "syncTimeoutMs": 5000, "disposeGraceMs": 5000}},
      {"id": "evolved-tool-workflow", "name": "@deepseek-ai/dsh-tool-workflow", "config": {"toolName": "workflow", "maxResultChars": 12000}}
    ],
    "fork_context_subagent": [
      {"id": "evolved-subagent-fork-provider", "name": "@deepseek-ai/dsh-subagent-fork-in-process", "config": {"providerName": "fork"}},
      {"id": "evolved-tool-fork-agent", "name": "@deepseek-ai/dsh-tool-subagent", "config": {"provider": "fork", "toolName": "fork_agent", "enableRunInBackground": false, "maxDepth": 2, "persona": "You are a bounded game-building specialist. Inspect or implement the delegated slice, verify executable evidence, report concrete findings, and avoid duplicating the parent agent's work."}}
    ],
    "context_efficiency_guards": [
      {"id": "evolved-compaction-result-pruner", "name": "@deepseek-ai/dsh-compaction-tool-result-pruner", "config": {"thresholdChars": 12000, "headChars": 7000, "tailChars": 3000}},
      {"id": "evolved-tool-timeout-policy", "name": "@deepseek-ai/dsh-tool-call-timeout-policy"}
    ]
  },
  "active_cordis_plugins": [],
  "environment": {}
}
